[Unit]
Description=orderdesk API
After=network.target postgresql.service

[Service]
User=deploy
WorkingDirectory=/srv/orderdesk
EnvironmentFile=/srv/orderdesk/.env
ExecStart=/srv/orderdesk/.venv/bin/uvicorn orderdesk.api:app --host 127.0.0.1 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
